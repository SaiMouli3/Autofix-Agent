# ---------------------------------------------------------------------------
# Synchronous Consulting AI — environment template. Copy to .env and fill in.
# Never commit real values. All secrets below are placeholders.
# ---------------------------------------------------------------------------

# development | test | production  (production enforces secure cookies, HSTS, HTTPS-only integrations)
SCA_ENV=production

# Fernet key(s) encrypting stored credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate (first one encrypts, all decrypt). Back this up separately.
SCA_SECRET_KEY=

# Required to create the first organization admin (shared out-of-band with the installer).
SCA_BOOTSTRAP_TOKEN=

POSTGRES_PASSWORD=
# SCA_DATABASE_URL is set by docker-compose; for other setups:
# SCA_DATABASE_URL=postgresql+psycopg://sca:PASSWORD@db-host:5432/sca

SCA_PUBLIC_BASE_URL=https://agents.example.com
# Optional deployment-wide OAuth sign-in apps (an organization's own app in Settings → Sign-in apps
# takes precedence). JSON keyed by provider: github, google, microsoft, salesforce, slack.
# SCA_OAUTH_CLIENTS={"github": {"client_id": "...", "client_secret": "..."}}
SCA_CORS_ORIGINS=https://agents.example.com

# Execution
SCA_RUNTIME=local                 # local (dev only) | docker (sandboxed, recommended)
SCA_MAX_WORKERS=4                 # concurrently executing tasks per API process
SCA_DEFAULT_TASK_TIMEOUT_S=1800
SCA_APPROVAL_TIMEOUT_S=3600
SCA_DOCKER_IMAGE=ghcr.io/openhands/agent-server:1.53.0-python
# SCA_DOCKER_NETWORK=sca-sandboxes
# SCA_DOCKER_PROXY_URL=http://proxy.internal:3128   # egress proxy for sandboxes
# SCA_DOCKER_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem     # mounted read-only into sandboxes

# Outbound network policy for integrations (private/loopback/metadata targets are blocked)
SCA_ALLOW_PRIVATE_NETWORK_TARGETS=false
# SCA_ALLOWED_PRIVATE_HOSTS=crm.internal.example.com
SCA_ALLOW_STDIO_MCP=false

# Retention (days)
SCA_EVENT_RETENTION_DAYS=90
SCA_AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Optional: seed the Experiential Labs provider when the first organization is
# created. The key is encrypted into the database at setup; afterwards manage it
# in Settings -> Model providers and remove it from this file.
# ---------------------------------------------------------------------------
EXP_LABS_BASE_URL=https://api.experientiallabs.ai/v1
EXP_LABS_API_KEY=
EXP_LABS_MODEL=claude-sonnet-5.5
