# Copy to .env (gitignored) and fill in. Never commit real keys.

# Web search / extraction — official website lookup, third-party sources (https://tavily.com)
TAVILY_API_KEY=

# Language model — any OpenAI-compatible chat-completions endpoint.
# Without these, research still extracts published facts and contacts but writes no summaries.
LLM_BASE_URL=https://api.experientiallabs.ai/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-5.5
LLM_PROVIDER_NAME=Experiential Labs
# LLM_TEMPERATURE=   # leave unset; some model routes only accept their default

# Identify this deployment to OpenStreetMap services (their usage policy requires it).
BIZINTEL_USER_AGENT="BizIntel/0.1 (contact: you@example.com)"

# Shared password for deployed instances (HTTP Basic auth). Strongly recommended on any public URL.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional
# HOST=0.0.0.0        # listen on all interfaces (required on hosting platforms)
# PORT=8787
# BIZINTEL_DATA_DIR=data
# BIZINTEL_PRODUCT_NAME="Atlas Intelligence"
# EXPORT_TTL_DAYS=7
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
