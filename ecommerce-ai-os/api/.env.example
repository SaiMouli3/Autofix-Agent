APP_ENV=development
PORT=8080
# Optional — the API runs fully in memory without these.
DATABASE_URL=postgres://eaos:eaos@localhost:5432/eaos?sslmode=disable
REDIS_URL=redis://localhost:6379
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
SEED_DEMO=true

# AI layer (optional). Without a key the assistant uses the deterministic reasoner.
# Experiential Labs gateway — used when EXP_LABS_API_KEY is set.
EXP_LABS_API_KEY=
EXP_LABS_BASE_URL=https://api.experientiallabs.ai/v1
# Model name as the gateway knows it (defaults to LLM_MODEL).
EXP_LABS_MODEL=
# openai = POST {base}/chat/completions · anthropic = POST {base}/messages
EXP_LABS_PROTOCOL=openai

# Direct Anthropic API (used when no Experiential Labs key is set).
ANTHROPIC_API_KEY=
# Set when routing through a gateway/proxy (e.g. a labs endpoint).
ANTHROPIC_BASE_URL=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Server-side refusal fallbacks (first-party API only). Defaults to on unless ANTHROPIC_BASE_URL is set.
LLM_FALLBACKS=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=
